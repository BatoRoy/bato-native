From 241aa63d3076ef2230c261f8e596ad34d7ec2070 Mon Sep 17 00:00:00 2001
From: bato <bato@local>
Date: Sat, 14 Nov 2026 12:40:42 +0100
Subject: [PATCH] bato patch: per-family fallback families

---
 src/font/fallback/mod.rs | 24 ++++++++++++++++++++++++
 src/font/system.rs       | 13 +++++++++++++
 2 files changed, 37 insertions(+)

diff --git a/src/font/fallback/mod.rs b/src/font/fallback/mod.rs
index 00b7218..4f692ba 100644
--- a/src/font/fallback/mod.rs
+++ b/src/font/fallback/mod.rs
@@ -192,6 +192,7 @@ pub struct FontFallbackIter<'a> {
     script_i: (usize, usize),
     common_i: usize,
     other_i: usize,
+    family_fallback_i: usize,
     end: bool,
     ideal_weight: fontdb::Weight,
 }
@@ -219,6 +220,7 @@ impl<'a> FontFallbackIter<'a> {
             script_i: (0, 0),
             common_i: 0,
             other_i: 0,
+            family_fallback_i: 0,
             end: false,
             ideal_weight,
         }
@@ -416,6 +418,28 @@ impl<'a> FontFallbackIter<'a> {
             }
         }
 
+        // bato: the default family's own fallback families, in order, before
+        // any script or common fallback (CSS: unicode-range subsets of one
+        // family, then the next family of the stack). Exact weight only.
+        if let Some(Family::Name(family)) = self.default_families.first().copied() {
+            while let Some(fallback_family) = self
+                .font_system
+                .family_fallbacks
+                .get(*family)
+                .and_then(|list| list.get(self.family_fallback_i))
+                .cloned()
+            {
+                self.family_fallback_i += 1;
+                let id = font_match_keys_iter(false)
+                    .find(|m_key| self.face_contains_family(m_key.id, &fallback_family))
+                    .map(|m_key| m_key.id);
+                if let Some(font) = id.and_then(|id| self.font_system.get_font(id, self.ideal_weight))
+                {
+                    return Some(font);
+                }
+            }
+        }
+
         while self.script_i.0 < self.scripts.len() {
             let script = self.scripts[self.script_i.0];
 
diff --git a/src/font/system.rs b/src/font/system.rs
index 7ec0cfe..f805f28 100644
--- a/src/font/system.rs
+++ b/src/font/system.rs
@@ -121,6 +121,10 @@ pub struct FontSystem {
 
     /// List of fallbacks
     pub(crate) fallbacks: Fallbacks,
+
+    /// bato: per-family fallback families, tried in order right after the
+    /// default family's face and before any script or common fallback.
+    pub(crate) family_fallbacks: HashMap<String, Vec<String>>,
 }
 
 impl fmt::Debug for FontSystem {
@@ -222,6 +226,7 @@ impl FontSystem {
             shape_buffer: ShapeBuffer::default(),
             dyn_fallback: Box::new(impl_fallback),
             fallbacks,
+            family_fallbacks: HashMap::default(),
         }
     }
 
@@ -230,6 +235,14 @@ impl FontSystem {
         Self::new_with_locale_and_db_and_fallback(locale, db, PlatformFallback)
     }
 
+    /// bato: set the families tried, in order and at the exact requested
+    /// weight, for glyphs the default face of `family` lacks, before the
+    /// script and common fallbacks (like the next families of a CSS font
+    /// stack, or the `unicode-range` subsets of one `@font-face` family).
+    pub fn set_family_fallbacks(&mut self, family: &str, fallbacks: Vec<String>) {
+        self.family_fallbacks.insert(family.into(), fallbacks);
+    }
+
     /// Get the locale.
     pub fn locale(&self) -> &str {
         &self.locale
-- 
