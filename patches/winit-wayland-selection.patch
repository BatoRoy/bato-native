         self.seats.insert(seat.id(), state);
     }
 
@@ -221,6 +223,7 @@ impl SeatHandler for WinitState {
         seat: WlSeat,
     ) {
         let _ = self.seats.remove(&seat.id());
+        crate::platform_impl::wayland::dnd::forget_seat(&seat);
         self.on_keyboard_destroy(&seat.id());
     }
 }
